# Configuración de AWS
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
AWS_REGION=us-east-1

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Documento de cobro / factura borrador
FACTURA_EMISOR_NOMBRE=
FACTURA_EMISOR_RNC=
FACTURA_ITBIS_PCT=18
# true = desglosar ITBIS tambien en eventos USD (por defecto no)
FACTURA_ITBIS_EN_USD=

# --- Certificación / producción Facturación Electrónica DGII (endpoints /fe/...) ---
# RNC emisor (BUENOHOTEL SRL)
DGII_FE_RNC=131631088
DGII_FE_SOFTWARE_NAME=BuenoHotel Eventos
DGII_FE_SOFTWARE_VERSION=1.0.0
# Certificado digital tributario (.p12): en Lambda use Layer PATH; en local puede usar PATH o BASE64
DGII_FE_CERT_PASSWORD=
DGII_FE_CERT_P12_BASE64=
# DGII_FE_CERT_P12_PATH=/opt/certs/dgii-fe.p12

# --- Emisión e-CF (POST /api/facturacion/emitir) ---
# CERT = CerteCF | PROD = eCF producción
DGII_ECF_ENVIRONMENT=PROD
# true = firma y guarda NCF en el registro, NO envía a DGII
DGII_ECF_DRY_RUN=true
# Tabla DynamoDB (PK tipoeCF String). Contador atómico lastAssigned.
DGII_NCF_TABLE=ncf_secuencias
# Primer número a asignar por tipo (si el item no existe aún)
DGII_NCF_START_31=1
DGII_NCF_START_32=1
# Tope del rango autorizado OFV (tipo 31: E310000000001–E310000000015)
DGII_NCF_MAX_31=15
DGII_NCF_FECHA_VENCIMIENTO=31-12-2027
DGII_EMISOR_MUNICIPIO=010100
DGII_EMISOR_PROVINCIA=010000
DGII_TIPO_INGRESOS=01
# FACTURA_EMISOR_RAZON=BUENOHOTEL, S.R.L.
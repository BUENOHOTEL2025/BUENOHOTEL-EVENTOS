{
  "name": "eventos-core-api",
  "version": "1.0.0",
  "description": "API para la gestión de eventos de BuenoHotel",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "cert:generar-xml": "node certificacion-dgii/generar-xml-sin-firmar.js",
    "cert:enviar": "node certificacion-dgii/enviar-set-firmados.js",
    "cert:verificar-firmados": "node certificacion-dgii/enviar-set-firmados.js --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.908.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/client-ses": "^3.1159.0",
    "@aws-sdk/client-translate": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.908.0",
    "@aws-sdk/util-dynamodb": "^3.908.0",
    "@vendia/serverless-express": "^4.12.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dgii-ecf": "^1.8.0",
    "dotenv": "^16.0.3",
    "express": "4.22.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "overrides": {
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}

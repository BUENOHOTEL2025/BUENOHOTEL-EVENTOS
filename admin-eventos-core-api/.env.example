# Configuración de AWS
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
AWS_REGION=us-east-1

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Maquetación borrador Factura Crédito Fiscal electrónica (RD) — antes de integrar DGII
FACTURA_EMISOR_NOMBRE=
FACTURA_EMISOR_DIRECCION=
FACTURA_EMISOR_TELEFONO=
FACTURA_EMISOR_RNC=
FACTURA_EMISOR_EMAIL=
FACTURA_EMISOR_SLOGAN=
FACTURA_ITBIS_PCT=18
# Si true, aplica % ITBIS tambien cuando el evento es USD (por defecto en USD no se desglosa ITBIS en el documento)
FACTURA_ITBIS_EN_USD=
FACTURA_CONDICION_DEFECTO=CONTADO
FACTURA_VALIDA_HASTA_LABEL=
FACTURA_EXPEDIENTE_RESOLUCION=
FACTURA_NOTA_LEGAL=
FACTURA_TITULO_SIN_NCF=
FACTURA_VENDEDOR_DEFECTO=
